<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Космический Кликер</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--tg-theme-bg-color, #1a1a2e);
            color: var(--tg-theme-text-color, #ffffff);
            margin: 0;
            padding: 16px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            user-select: none;
            overflow-x: hidden;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .coins {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, #ffd700, #ff8c00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }
        .per-click {
            font-size: 14px;
            opacity: 0.7;
            margin-top: 4px;
        }
        .click-area {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 20px 0;
        }
        .click-btn {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: none;
            background: radial-gradient(circle at 30% 30%, #ffd700, #ff8c00);
            font-size: 80px;
            cursor: pointer;
            box-shadow: 0 10px 30px rgba(255, 200, 0, 0.4);
            transition: transform 0.08s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .click-btn:active {
            transform: scale(0.92);
            box-shadow: 0 5px 15px rgba(255, 200, 0, 0.6);
        }
        .float {
            position: absolute;
            font-size: 24px;
            font-weight: 700;
            color: #ffd700;
            pointer-events: none;
            animation: floatUp 0.8s ease-out forwards;
        }
        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-80px) scale(1.5); }
        }
        .shop {
            width: 100%;
            max-width: 400px;
        }
        .shop h2 {
            font-size: 18px;
            margin: 20px 0 10px;
            opacity: 0.9;
        }
        .upgrade {
            background: var(--tg-theme-secondary-bg-color, #2a2a4a);
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: transform 0.1s, opacity 0.2s;
        }
        .upgrade:active { transform: scale(0.98); }
        .upgrade.disabled { opacity: 0.4; cursor: not-allowed; }
        .upgrade-info { flex: 1; }
        .upgrade-name { font-weight: 600; font-size: 15px; }
        .upgrade-desc { font-size: 12px; opacity: 0.6; margin-top: 2px; }
        .upgrade-cost {
            font-weight: 700;
            color: #ffd700;
            font-size: 15px;
            white-space: nowrap;
            margin-left: 10px;
        }
        .reset {
            margin: 20px 0;
            background: transparent;
            color: var(--tg-theme-hint-color, #888);
            border: 1px solid var(--tg-theme-hint-color, #888);
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="header">
        <p class="coins" id="coins">0</p>
        <div class="per-click" id="perClick">+1 за клик</div>
    </div>

    <div class="click-area" id="clickArea">
        <button class="click-btn" id="clickBtn">🪐</button>
    </div>

    <div class="shop">
        <h2>🛒 Магазин</h2>
        <div id="shop"></div>
    </div>

    <button class="reset" onclick="resetGame()">Сбросить прогресс</button>

    <script>
        const tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();

        // ===== Состояние игры =====
        let state = {
            coins: 0,
            perClick: 1,
            autoIncome: 0,
            critChance: 0,   // 0..1
            critMultiplier: 5,
            upgrades: {
                clickPower: 0,
                autoClicker: 0,
                critChance: 0,
                multiplier: 0
            }
        };

        // ===== Определения улучшений =====
        const UPGRADES = [
            {
                id: 'clickPower',
                name: '💪 Сила клика',
                desc: () => `+1 к клику (сейчас +${state.perClick})`,
                cost: () => Math.floor(10 * Math.pow(1.5, state.upgrades.clickPower)),
                apply: () => { state.perClick += 1; }
            },
            {
                id: 'autoClicker',
                name: '🤖 Автокликер',
                desc: () => `+1 монета/сек (сейчас ${state.autoIncome})`,
                cost: () => Math.floor(50 * Math.pow(1.6, state.upgrades.autoClicker)),
                apply: () => { state.autoIncome += 1; }
            },
            {
                id: 'critChance',
                name: '🎯 Крит-удар',
                desc: () => `+5% шанс крита (сейчас ${Math.round(state.critChance * 100)}%)`,
                cost: () => Math.floor(200 * Math.pow(2, state.upgrades.critChance)),
                apply: () => { state.critChance = Math.min(0.75, state.critChance + 0.05); }
            },
            {
                id: 'multiplier',
                name: '✨ Множитель',
                desc: () => `Умножает весь доход (ур. ${state.upgrades.multiplier})`,
                cost: () => Math.floor(1000 * Math.pow(2.5, state.upgrades.multiplier)),
                apply: () => { state.upgrades.multiplier += 1; }
            }
        ];

        // ===== Сохранение =====
        function save() {
            localStorage.setItem('clicker_save', JSON.stringify(state));
        }
        function load() {
            const raw = localStorage.getItem('clicker_save');
            if (raw) {
                try { state = { ...state, ...JSON.parse(raw) }; } catch(e) {}
            }
        }

        // ===== UI =====
        const coinsEl = document.getElementById('coins');
        const perClickEl = document.getElementById('perClick');
        const shopEl = document.getElementById('shop');
        const clickBtn = document.getElementById('clickBtn');
        const clickArea = document.getElementById('clickArea');

        function getMultiplier() {
            return 1 + state.upgrades.multiplier;
        }

        function render() {
            const mult = getMultiplier();
            coinsEl.textContent = Math.floor(state.coins).toLocaleString('ru-RU');
            perClickEl.textContent = `+${state.perClick * mult} за клик · ${state.autoIncome * mult}/сек`;
            renderShop();
        }

        function renderShop() {
            shopEl.innerHTML = '';
            const mult = getMultiplier();
            UPGRADES.forEach(up => {
                const cost = up.cost();
                const canAfford = state.coins >= cost;
                const div = document.createElement('div');
                div.className = 'upgrade' + (canAfford ? '' : ' disabled');
                div.innerHTML = `
                    <div class="upgrade-info">
                        <div class="upgrade-name">${up.name}</div>
                        <div class="upgrade-desc">${up.desc()}</div>
                    </div>
                    <div class="upgrade-cost">${cost.toLocaleString('ru-RU')} 💰</div>
                `;
                div.onclick = () => buyUpgrade(up);
                shopEl.appendChild(div);
            });
        }

        function buyUpgrade(up) {
            const cost = up.cost();
            if (state.coins < cost) {
                tg.HapticFeedback.notificationOccurred('error');
                return;
            }
            state.coins -= cost;
            up.apply();
            tg.HapticFeedback.notificationOccurred('success');
            save();
            render();
        }

        // ===== Клик =====
        clickBtn.addEventListener('click', (e) => {
            const mult = getMultiplier();
            let earned = state.perClick * mult;
            let isCrit = false;

            if (Math.random() < state.critChance) {
                earned *= state.critMultiplier;
                isCrit = true;
            }

            state.coins += earned;
            tg.HapticFeedback.impactOccurred(isCrit ? 'heavy' : 'light');

            showFloat(e, `+${Math.floor(earned)}`, isCrit);
            render();
            save();
        });

        function showFloat(e, text, isCrit) {
            const rect = clickArea.getBoundingClientRect();
            const x = (e.clientX || rect.left + rect.width / 2) - rect.left;
            const y = (e.clientY || rect.top + rect.height / 2) - rect.top;

            const el = document.createElement('div');
            el.className = 'float';
            el.textContent = isCrit ? `${text} КРИТ!` : text;
            if (isCrit) el.style.color = '#ff4444';
            el.style.left = (x - 20) + 'px';
            el.style.top = y + 'px';
            clickArea.appendChild(el);
            setTimeout(() => el.remove(), 800);
        }

        // ===== Автодоход =====
        setInterval(() => {
            if (state.autoIncome > 0) {
                state.coins += state.autoIncome * getMultiplier();
                render();
            }
        }, 1000);

        // Автосохранение каждые 5 секунд
        setInterval(save, 5000);
        window.addEventListener('beforeunload', save);

        function resetGame() {
            if (confirm('Точно сбросить весь прогресс?')) {
                localStorage.removeItem('clicker_save');
                location.reload();
            }
        }

        // ===== Старт =====
        load();
        render();
    </script>
</body>
</html>